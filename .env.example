# ==========================================
# DeRouter Telegram Bot 設定範例
# 複製成 .env 後填入自己的值：cp .env.example .env
# ==========================================

# 🔑 Telegram bot token（向 @BotFather 申請）
TELEGRAM_BOT_TOKEN=

# 🔑 DeRouter management key（DeRouter 後台取得）
DEROUTER_MGMT_KEY=
# 接收推播與調速通知的 Telegram user ID（可向 @userinfobot 查詢）
# 只有這個 ID 能使用 /derouter、/quota、/speed 指令
DEROUTER_CHAT_ID=

# ---- 收益推播設定（皆為選填）----
# 今日收益每跨過多少美元提醒一次，預設 1
DEROUTER_ALERT_STEP=1
# 每天幾點送前一日總結（台北時間 0–23），預設 8
DEROUTER_DAILY_HOUR=8
# 第一期訂閱起始日 YYYY-MM-DD，之後每月同日自動滾入新一期；用於回本進度
DEROUTER_BILLING_START=
# 月成本（美元），用於回本進度條與月底推估
DEROUTER_MONTHLY_COST=
# 日成本（美元），用於昨日損益
DEROUTER_DAILY_COST=
# 每日達標門檻（美元，逗號分隔）。留空則預設為日成本與其兩倍
DEROUTER_GOAL_TARGETS=

# ---- 自動調速設定（皆為選填）----
# 帳號排程規則，JSON 陣列。留空＝不自動調速，仍可用 /speed 手動調
#   alias        指令用短代號，例如 /speed main speed_2x
#   dayMode      日間相位要切到的模式
#   nightMode    夜間相位要切到的模式
#   thresholdUsd 當日收益達此金額就切到 thresholdMode（選填）
# 模式：humanlike / normal / speed_2x / speed_3x / speed_5x
DISPATCH_ACCOUNTS=[{"alias":"main","email":"you@example.com","dayMode":"speed_5x","nightMode":"normal","thresholdUsd":14,"thresholdMode":"speed_2x"},{"alias":"sub","email":"sub@example.com","dayMode":"speed_2x","nightMode":"normal"}]
# 日間相位起始的台北小時，預設 8（＝UTC 換日、當日收益歸零時刻）
DISPATCH_MORNING_HOUR=8
# 設 false 可暫停自動排程（仍保留 /speed 手動指令）
DISPATCH_ENABLED=true
